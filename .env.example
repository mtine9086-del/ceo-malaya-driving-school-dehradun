# ------------------------------------------------------------------
# Malay Driving School — environment variables (copy to .env)
# All are optional; the site builds and runs without them.
# ------------------------------------------------------------------

# HTTPS endpoint that accepts enquiry form submissions as JSON POST.
# Any form backend works: your own API, Formspree, a CRM webhook, etc.
# When unset, the form validates and confirms locally only.
VITE_ENQUIRY_ENDPOINT=

# Public production URL (used for canonical / OG tags when provided).
# Also update `baseUrl` in src/config/site.ts.
VITE_SITE_URL=https://malaydrivingschool.in
